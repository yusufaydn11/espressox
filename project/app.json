{
  "expo": {
    "name": "Espresso X",
    "slug": "espresso-x",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#FAF9F6"
    },
    "ios": {
      "bundleIdentifier": "com.espressox.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Kampanya ve ödül QR kodlarını okumak için kamera izni gerekir.",
        "NSLocationWhenInUseUsageDescription": "Size en yakın Espresso X mağazalarını göstermek için konum bilgisi kullanılır.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserTrackingUsageDescription": "Bu izin, kampanya performansını ölçmek için kullanılır."
      },
      "associatedDomains": ["applinks:espressox.app"],
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.espressox.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF9F6"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "googleServicesFile": "google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": {
            "scheme": "https",
            "host": "espressox.app"
          },
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#C8102E"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermissionText": "Kampanya ve ödül QR kodlarını okumak için kamera erişimi gerekir."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Size en yakın mağazaları göstermek için konum izni gerekir."
        }
      ]
    ],
    "experiments": {
      "tsconfigPaths": true
    }
  }
}
