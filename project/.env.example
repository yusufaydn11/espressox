# Supabase (required for all builds)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# EAS / push notifications (required for native push token registration)
# Set in EAS secrets for production: eas env:create --environment production --name EAS_PROJECT_ID --value <uuid>
EAS_PROJECT_ID=

# Production Supabase — set ONLY in EAS production environment secrets, NOT in committed .env
# eas env:create --environment production --name EXPO_PUBLIC_SUPABASE_URL --value <prod-url>
# eas env:create --environment production --name EXPO_PUBLIC_SUPABASE_ANON_KEY --value <prod-anon-key>

# Store / legal URLs (optional — in-app legal text always available)
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=destek@espressox.com

# Maintenance mode (optional)
EXPO_PUBLIC_MAINTENANCE_MODE=false
# Set true only after iyzico FAZ1 is deployed to production
EXPO_PUBLIC_ENABLE_CARD_PAYMENTS=false
VITE_MAINTENANCE_MODE=false

# Smoke test credentials (local/CI only — never ship in production builds)
SMOKE_ADMIN_EMAIL=
SMOKE_ADMIN_PASSWORD=
SMOKE_STAFF_EMAIL=
SMOKE_STAFF_PASSWORD=
SMOKE_FRANCHISE_EMAIL=
SMOKE_FRANCHISE_PASSWORD=
SMOKE_SUPER_ADMIN_EMAIL=
SMOKE_SUPER_ADMIN_PASSWORD=

# E2E URLs (local dev only)
E2E_CUSTOMER_URL=http://localhost:8080
E2E_ADMIN_URL=http://localhost:4173

# iyzico sandbox (server-side — set in Supabase Edge secrets only, never commit values)
IYZICO_API_KEY=
IYZICO_SECRET_KEY=

# Android FCM — copy google-services.json.example → google-services.json with real Firebase project
# Do not commit google-services.json
