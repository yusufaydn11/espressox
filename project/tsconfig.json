{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "nativewind",
    "module": "esnext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@shared/*": ["shared/*"],
      "@env": ["env.d.ts"]
    },
    "typeRoots": ["./node_modules/@types"],
    "types": ["nativewind/types"]
  },
  "include": ["**/*.ts", "**/*.tsx", "nativewind-env.d.ts", "shared/**/*.ts", "shared/**/*.d.ts"],
  "exclude": ["node_modules", "supabase/functions", "admin-web", "dist", "tailwind.config.ts"]
}
